local sessionId = tostring(os.time()) .. "_" .. tostring(player.UserId)
local lastFirebaseTime = 0

local function pushSession(reason)
    task.spawn(function()
        pcall(function()
            local placeId = tostring(game.PlaceId)
            local jobId = game.JobId
            if not jobId or jobId == "" then jobId = "Studio" end

            local data = {
                username = player.Name,
                userId = player.UserId,
                placeId = placeId,
                jobId = jobId,
                gameName = getGameName(),
                joinUrl = "https://www.roblox.com/games/start?placeId=" .. placeId .. "&gameInstanceId=" .. jobId,
                profileUrl = "https://www.roblox.com/users/" .. player.UserId .. "/profile",
                executor = (identifyexecutor and identifyexecutor()) or "Unknown",
                status = "active",
                timestamp = os.time(),
                sessionId = sessionId,
                reason = reason or "auto",
            }

            local res = firebaseReq("PUT", "/sessions/" .. sessionId .. ".json", data)
            if res then
                print("[REN] 📊 Session OK:", reason)
            else
                warn("[REN] ❌ Session failed")
            end
        end)
    end)
end

local function deleteSession()
    pcall(function()
        firebaseReq("DELETE", "/sessions/" .. sessionId .. ".json")
    end)
end

local function trackExecute(mapName)
    task.spawn(function()
        pcall(function()
            local key = os.time() .. "_" .. player.UserId .. "_" .. math.random(1000, 9999)
            local data = {
                username = player.Name,
                userId = player.UserId,
                placeId = tostring(game.PlaceId),
                gameName = mapName or getGameName(),
                timestamp = os.time(),
            }
            local res = firebaseReq("PUT", "/executes/" .. key .. ".json", data)
            if res then
                print("[REN] ✅ Execute tracked:", mapName)
            else
                warn("[REN] ❌ Execute track failed")
            end
        end)
    end)
end

local function startTracking()
    lastFirebaseTime = os.time()
    pushSession("initial")

    task.spawn(function()
        while player and player.Parent do
            task.wait(15)
            if os.time() - lastFirebaseTime >= CONFIG.TrackCooldown then
                lastFirebaseTime = os.time()
                pushSession("heartbeat")
            end
        end
    end)

    player.AncestryChanged:Connect(function()
        if not player.Parent then deleteSession() end
    end)
end

